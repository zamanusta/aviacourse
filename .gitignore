# Everything below lives on a persistent Docker volume, not in the image.
# Plugins and translations are managed from wp-admin; uploads are user media.
wp-content/plugins/
wp-content/languages/
wp-content/uploads/
wp-content/fonts/
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/litespeed/
wp-content/backup*/
wp-content/ai1wm-backups/
wp-content/debug.log
wp-content/advanced-cache.php
wp-content/object-cache.php

# Never commit. Anchored to the repo root on purpose: an unanchored *.zip
# also swallows theme-bundled plugin packages such as
# wp-content/themes/eduhap/inc/plugins/eduhap-core.zip, which TGMPA installs from.
/*.sql
/*.zip
*.env
.env*
error_log

# OS noise
.DS_Store
Thumbs.db
